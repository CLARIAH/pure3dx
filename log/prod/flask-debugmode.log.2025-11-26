ttps://avatars.githubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 9843973, 'digest': None, 'download_count': 9, 'created_at': '2023-09-01T19:09:47Z', 'updated_at': '2023-09-01T19:09:52Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.32.0/voyager-tools-v0.32.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.32.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.32.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* Support for wall-mounted objects in AR\r\n  * Experience is modal (set in scene file) - wall or floor based\r\n  * AR intro text changes to identify mode\r\n* Scale display in AR\r\n  * Indicator appears when scaling to show integer scale factor from base\r\n  * Tracks to edge of window when model is off screen\r\n* Support for pre-scaling AR models\r\n  * Some models are much too big for a good indoor AR experience. You can now add an AR scale factor so the models appear at a reasonable size.\r\n  * Pre-scaled models will flash scale indicator immediately on load'}
