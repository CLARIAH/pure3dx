thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 10990943, 'digest': None, 'download_count': 4, 'created_at': '2024-11-26T18:26:59Z', 'updated_at': '2024-11-26T18:27:05Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.46.0/voyager-tools-v0.46.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.46.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.46.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* Italian langauge support (@kgschoueri)\r\n\r\n**Bug fixes:**\r\n* Linked properties disabled in Story UI to avoid confusion (@sdumetz) (#314)\r\n* URL attributes appropriately processed when changed on scene reload (@sdumetz)\r\n* Docker build permissions issues fixed (@jbylsma)(#310)\r\n\r\n**Misc:**\r\n* Optimized annotation rendering (@sdumetz)', 'mentions_count': 3}
