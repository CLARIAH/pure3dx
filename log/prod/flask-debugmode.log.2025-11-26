thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 11158692, 'digest': None, 'download_count': 11, 'created_at': '2025-05-29T19:54:30Z', 'updated_at': '2025-05-29T19:54:36Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.52.0/voyager-tools-v0.52.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.52.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.52.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* 3D helper updates and improvements in Story (@sdumetz )\r\n  * Helpers added for all light types\r\n  * Axes helper added to lights, models, and scene\r\n  * Transform inputs color-coded to match axes visualization\r\n  * Model origin visualization added \r\n\r\n**Bug fixes:**\r\n* Independent geometry/texture load via param/attribute fixed\r\n* Shadows enabled for meshes coming from Independent geometry load\r\n* Fixed bug causing elements of the setup data cache to be overwritten when hot-swapping scenes', 'mentions_count': 1}
