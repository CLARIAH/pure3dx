ercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 8116241, 'digest': None, 'download_count': 10, 'created_at': '2022-04-08T13:44:40Z', 'updated_at': '2022-04-08T13:44:47Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.16.1/voyager-tools-v0.16.1.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.16.1', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.16.1', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* Main menu and main toolbar are now scrollable when they overflow\r\n  \r\n**Bug fixes:**\r\n* #127 Fixed decoding of file paths dropped in Story Standalone mode\r\n* Toolbar menu is no longer clipped vertically when overflowing.'}
