thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 9782463, 'digest': None, 'download_count': 9, 'created_at': '2023-06-01T20:12:11Z', 'updated_at': '2023-06-01T20:12:17Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.29.0/voyager-tools-v0.29.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.29.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.29.0', 'body': "Changelog:\r\n\r\n**New Features:**\r\n* Added support for \\<sup\\> and \\<sub\\> tags in annotations\r\n* Added support for animating light position\r\n* Hawaiian language UI option\r\n* Added prompt to encourage user to interact with the scene\r\n  * Enabled by default, can be disabled by setting the 'prompt' attribute of the Explorer component to false.\r\n  * Disappears when user interacts\r\n  * Disabled if navigation is also disabled\r\n\r\n**Bug fixes:**\r\n* Fixed odd drag/drop behavior (#200)\r\n* Changed pointer to 'grab' when over interactive 3D window\r\n* Fix for language changing race condition (#211 @sdumetz)\r\n* Fix for inability to delete the last tour in a scene", 'mentions_count': 1}
