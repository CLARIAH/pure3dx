thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 9989019, 'digest': None, 'download_count': 11, 'created_at': '2023-11-01T17:37:52Z', 'updated_at': '2023-11-01T17:37:58Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.34.0/voyager-tools-v0.34.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.34.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.34.0', 'body': 'Changelog:\r\n\r\n**Bug fixes:**\r\n* Fix for null node bug when swapping side-by-side scenes\r\n* Fixed bad shadow root reference when using side-by-side scenes\r\n\r\n**Misc:**\r\n* Dependency updates to address vulnerabilities\r\n* Three.js updated to v156\r\n  * This includes updates to ff-scene and ff-three libraries to support this version \r\n  * **Note** - this includes the Three.js update to more physically accurate lighting. Until we can support this, the previously used Pi lighting factor has been reapplied.'}
