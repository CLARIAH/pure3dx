thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 11019982, 'digest': None, 'download_count': 9, 'created_at': '2025-02-28T13:05:31Z', 'updated_at': '2025-02-28T13:05:37Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.49.0/voyager-tools-v0.49.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.49.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.49.0', 'body': "Changelog:\r\n\r\n**New Features:**\r\n* Screen reader accessible alt text now supported for tour steps\r\n  * Add descriptive text in the Tour Editor panel step details pane \r\n\r\n**Bug fixes:**\r\n* Scene bounding box now only includes visible geometry\r\n* Fixed 'Center' button regression (#344)\r\n* Article panel input styling fixed\r\n* Fix for document dispose with no active document (#347) (@sdumetz)", 'mentions_count': 1}
