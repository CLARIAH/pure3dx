tps://avatars.githubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 7641348, 'digest': None, 'download_count': 9, 'created_at': '2021-09-16T15:34:48Z', 'updated_at': '2021-09-16T15:34:56Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.14.0/voyager-tools-v0.14.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.14.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.14.0', 'body': 'Changelog:\r\n\r\n* Migrated to Webpack 5.5\r\n  * Required plugin updates as well as ff-lib fixes.\r\n* TS to 4.3.5\r\n* lit-element to 2.5.1\r\n* Three.js to 0.132.2\r\n\r\nNew features:\r\n* Double-sided rendering override.\r\n* Environment maps now applied to entire scene if any model has metalness/roughness maps. Also includes automatic PMREM via Three.js.\r\n* No minimum annotation box size enforced for annotations < 40 chars.'}
