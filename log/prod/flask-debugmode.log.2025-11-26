thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 10188801, 'digest': None, 'download_count': 13, 'created_at': '2024-05-22T21:53:19Z', 'updated_at': '2024-05-22T21:53:32Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.41.0/voyager-tools-v0.41.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.41.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.41.0', 'body': 'Changelog:\r\n\r\n**Bug fixes:**\r\n* Set image max-width to 100% and image height to auto in article styles (@sdumetz)\r\n* Fix for manual slider input fields (#273)\r\n  * If field is classified as percent, manual inputs now represent a more intuitive whole-number percent\r\n* Fix for custom floor heights not saving to scene file (#272)\r\n* "Read More" link in extended overlay annotations has been fixed\r\n* Fixed - Dropdown (Options) widgets were not displaying correct selection after re-rendering. (#277)', 'reactions': {'url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/releases/156729725/reactions', 'total_count': 1, '+1': 1, '-1': 0, 'laugh': 0, 'hooray': 0, 'confused': 0, 'heart': 0, 'rocket': 0, 'eyes': 0}, 'mentions_count': 1}
