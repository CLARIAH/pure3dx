thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 9933885, 'digest': None, 'download_count': 14, 'created_at': '2024-01-25T20:14:29Z', 'updated_at': '2024-01-25T20:14:36Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.37.0/voyager-tools-v0.37.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.37.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.37.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* Audio task enabled for Standalone mode of Voyager Story\r\n\r\n**Bug fixes:**\r\n* Circle annotations refactored to HTML base. Improves flexibility and removes dependency on abandoned three-bmfont-text package\r\n* New audio elements auto-select on creation\r\n* Lighting factor application fix for directional lights (#244)\r\n* Fix for failing runtime mode change (#246)\r\n  * Note - this results in suboptimal memory release if destroying the component on a page. We recommend reloading new content rather than destroying/creating.\r\n* Shader bug fixes to match Three.js r158 (replaces #247)\r\n\r\n**Misc:**\r\n* Three.js updated to r158\r\n* Cleanup of extraneous Quill (old article editor) references'}
