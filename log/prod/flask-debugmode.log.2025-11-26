thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 11028744, 'digest': None, 'download_count': 10, 'created_at': '2024-12-20T17:29:04Z', 'updated_at': '2024-12-20T17:29:10Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.47.0/voyager-tools-v0.47.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.47.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.47.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* File loads now cancellable (@sdumetz)\r\n* Model loading faster with more async processes (@sdumetz)\r\n\r\n**Bug fixes:**\r\n* Popup windows tied to component bounds instead of window. Styles updated appropriately. (#329)\r\n* CC button is hidden when there is no caption file available\r\n* AR touch plane now scales appropriately with very small object\r\n* Annotation views now support rotation and translation\r\n  * View transitions tuned to distance traveled \r\n\r\n**Misc**\r\n* Minimum Node engine requirement increased to 16.20.2', 'mentions_count': 1}
