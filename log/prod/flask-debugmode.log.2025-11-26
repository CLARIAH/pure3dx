ercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 9559753, 'digest': None, 'download_count': 11, 'created_at': '2022-07-28T15:43:08Z', 'updated_at': '2022-07-28T15:43:12Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.20.0/voyager-tools-v0.20.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.20.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.20.0', 'body': "Changelog:\r\n\r\n**API updates:**\r\n* #151 getCameraOffset and getCameraOrbit updated with option parameter 'type' to indicate what data to get - min, max, or active values.\r\n* 'root' and 'document' attributes can now be set directly on the Voyager Story component.\r\n\r\n**Bug fixes:**\r\n* #52 Stopped saving/loading open article as active. Single articles will automatically open with reader, otherwise menu.\r\n* #149 Added UI warning when AR is available on the device but blocked for some reason.\r\n\r\n**Misc:**\r\n* Dependency updates to address vulnerabilities\r\n* Documentation for all API updates"}
