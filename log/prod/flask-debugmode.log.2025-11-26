thubusercontent.com/u/22783547?v=4', 'gravatar_id': '', 'url': 'https://api.github.com/users/gjcope', 'html_url': 'https://github.com/gjcope', 'followers_url': 'https://api.github.com/users/gjcope/followers', 'following_url': 'https://api.github.com/users/gjcope/following{/other_user}', 'gists_url': 'https://api.github.com/users/gjcope/gists{/gist_id}', 'starred_url': 'https://api.github.com/users/gjcope/starred{/owner}{/repo}', 'subscriptions_url': 'https://api.github.com/users/gjcope/subscriptions', 'organizations_url': 'https://api.github.com/users/gjcope/orgs', 'repos_url': 'https://api.github.com/users/gjcope/repos', 'events_url': 'https://api.github.com/users/gjcope/events{/privacy}', 'received_events_url': 'https://api.github.com/users/gjcope/received_events', 'type': 'User', 'user_view_type': 'public', 'site_admin': False}, 'content_type': 'application/x-zip-compressed', 'state': 'uploaded', 'size': 11015366, 'digest': None, 'download_count': 17, 'created_at': '2025-01-31T19:18:59Z', 'updated_at': '2025-01-31T19:19:06Z', 'browser_download_url': 'https://github.com/Smithsonian/dpo-voyager/releases/download/v0.48.0/voyager-tools-v0.48.0.zip'}], 'tarball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/tarball/v0.48.0', 'zipball_url': 'https://api.github.com/repos/Smithsonian/dpo-voyager/zipball/v0.48.0', 'body': 'Changelog:\r\n\r\n**New Features:**\r\n* Component properties can be individually disabled in Story UI (@sdumetz) (#333)\r\n  * Disabling makes use of accessibility appropriate aria-disabled\r\n* Editing of custom collections metadata fields now supported in Story \'Collection\' tab\r\n\r\n**Bug fixes:**\r\n* Copyright statement in Story \'Collection\' tab can now be empty\r\n  * SI default statement has been removed\r\n* Cleaning up after document reload refactored to address #340 \r\n* "end of article" text for accessibility compliance now styled to be screen reader only (#342)\r\n* Root path now always gets trailing slash to fix bug when only using document attribute in component config (@sdumetz)\r\n\r\n**Misc**\r\n* Dependencies updated to address vulnerabilities\r\n* New article editor error when an article is not found (@sdumetz)\r\n* Text area edit widgets can now have a defined number of rows shown', 'mentions_count': 1}
